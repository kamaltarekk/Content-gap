# ---------------------------------------------------------------------------
# Content Gap Intelligence v0 — environment configuration
# Copy to .env and adjust. Everything works with the FAKE providers by default,
# so no external credentials are required to run the demo or the test suite.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://cgi:cgi@localhost:5433/cgi

# --- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Comma-separated list of allowed dashboard/extension origins for CORS.
CORS_ORIGINS=http://localhost:5173,chrome-extension://*

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER = "fake" (deterministic, no network) | "anthropic"
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings -------------------------------------------------------------
# EMBEDDING_PROVIDER = "local" (deterministic multilingual hashing, no network)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# --- Crawler ----------------------------------------------------------------
CRAWLER_USER_AGENT=ContentGapIntelligenceBot/0.0 (+https://example.com/bot)
CRAWLER_PER_DOMAIN_RPS=0.5
CRAWLER_RESPECT_ROBOTS=true
# Playwright fallback is opt-in; the demo and tests never need it.
CRAWLER_PLAYWRIGHT_FALLBACK=false

# --- Pricing (configurable, never hard-coded in source) ---------------------
# USD per 1,000,000 tokens. Set to match your provider's current price sheet.
PRICE_LLM_INPUT_PER_MTOK=3.00
PRICE_LLM_OUTPUT_PER_MTOK=15.00
PRICE_EMBEDDING_PER_MTOK=0.00

# --- Safety limits (see packages/shared/src/limits.ts for defaults) ---------
LIMIT_OWNED_URLS=100
LIMIT_COMPETITOR_URLS=50
LIMIT_VOC_ROWS=5000
LIMIT_MAX_CHUNKS_PER_RUN=5000
LIMIT_MAX_TOKENS_PER_RUN=2000000
LIMIT_WEEKLY_COST_BUDGET_USD=25

# --- Data retention ---------------------------------------------------------
RETENTION_SNAPSHOT_DAYS=180

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
