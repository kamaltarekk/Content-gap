# Content Diagnosis & Competitive Gap Analysis — environment template.
# Copy to .env and fill in. The real .env is gitignored and must never be committed.

# --- Runtime ---
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO

# --- Auth ---
# none = local no-auth development (auto dev admin). session = HttpOnly cookie (required in prod).
AUTH_MODE=none
SESSION_SECRET=dev-insecure-change-me
SESSION_COOKIE_NAME=cdga_session
SESSION_HTTPS_ONLY=false

# --- Database (async URL for the app; Alembic derives a sync URL) ---
DATABASE_URL=postgresql+asyncpg://cgi:cgi@localhost:5433/cdga

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3/MinIO) ---
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=cdga
STORAGE_SECURE=false

# --- AI provider (validated on startup; never called by the foundation phase) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_THINKING_MODE=adaptive
AI_EFFORT=medium

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
